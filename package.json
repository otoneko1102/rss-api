    "hono": "^4.12.27",
    "hono-feed": "^0.1.0",
    "ky": "^2.0.2",
    "markdown-it": "^14.1.1",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^26.0.1",
